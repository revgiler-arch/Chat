rules_version = '2';

// Правила доступа к базе: каждый видит только свои чаты и пишет только от своего имени.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    // id чата двух людей — как в приложении: uid по алфавиту через «_»
    function chatOf(a, b) { return a < b ? a + '_' + b : b + '_' + a; }

    // Блокировка: пока в чате кто-то кого-то заблокировал, ни писать, ни звонить нельзя
    function chatOpen(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.get('blockedBy', []).size() == 0;
    }

    // Профили: читать может любой вошедший (чтобы находить друг друга), менять — только свой
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,20}$');
    }

    // Занятые имена @username: одно имя — один владелец
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me()
        && name.matches('^[a-z0-9_]{3,20}$');
      allow delete: if signedIn() && resource.data.uid == me();
    }

    function isGroup(d) { return d.get('type', 'direct') == 'group'; }
    function setOf(d, f) { return d.get(f, []).toSet(); }

    // Группы: владелец меняет название, приглашает и удаляет участников; вступить можно
    // только самому, приняв приглашение (напрямую добавить человека в участники нельзя)
    function groupUpdate() {
      let d0 = resource.data;
      let d1 = request.resource.data;
      let changed = d1.diff(d0).affectedKeys();
      let joined = setOf(d1, 'members').difference(setOf(d0, 'members'));
      let left = setOf(d0, 'members').difference(setOf(d1, 'members'));
      let uninvited = setOf(d0, 'invited').difference(setOf(d1, 'invited'));
      let newInvites = setOf(d1, 'invited').difference(setOf(d0, 'invited'));
      return d1.get('type', '') == 'group' && (
        // обычная жизнь чата: последнее сообщение, прочитано, печатает…
        (me() in d0.members && !changed.hasAny(['type', 'owner', 'members', 'invited', 'invitedBy', 'name']))
        // владелец: название, приглашения, удаление участников
        || (me() == d0.owner && d1.owner == d0.owner && me() in d1.members
            && joined.size() == 0
            && d1.members.size() + d1.get('invited', []).size() <= 50
            && !setOf(d1, 'invited').hasAny(d1.members)
            && d1.name is string && d1.name.size() >= 1 && d1.name.size() <= 50)
        // принять приглашение: только себя, из invited в members
        || (me() in d0.get('invited', []) && changed.hasOnly(['members', 'invited', 'read'])
            && uninvited == [me()].toSet() && newInvites.size() == 0
            && joined == [me()].toSet() && left.size() == 0)
        // отклонить приглашение
        || (me() in d0.get('invited', []) && changed.hasOnly(['invited'])
            && uninvited == [me()].toSet() && newInvites.size() == 0)
        // выйти из группы; владелец при выходе передаёт группу другому участнику
        || (me() in d0.members && changed.hasOnly(['members', 'owner'])
            && left == [me()].toSet() && joined.size() == 0
            && (d0.owner != me() ? d1.owner == d0.owner : d1.owner in d1.members))
      );
    }

    // Чаты: на двоих и группы. Доступ — участникам; приглашённые видят только саму группу
    match /chats/{chatId} {
      allow read: if signedIn()
        && (me() in resource.data.members || me() in resource.data.invited);
      allow create: if signedIn() && (
        (!isGroup(request.resource.data)
          && me() in request.resource.data.members
          && request.resource.data.members.size() == 2
          // id чата обязан совпадать с парой участников — иначе можно «занять» чужой чат заранее
          && chatId == chatOf(request.resource.data.members[0], request.resource.data.members[1])
          && request.resource.data.get('blockedBy', []).toSet().hasOnly([me()]))
        || (isGroup(request.resource.data)
          && chatId.matches('g_[A-Za-z0-9]{10,40}')
          && request.resource.data.owner == me()
          && request.resource.data.members == [me()]
          && request.resource.data.invited is list
          && request.resource.data.invited.size() <= 49
          && !(me() in request.resource.data.invited)
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 50)
      );
      allow update: if signedIn() && (
        (!isGroup(resource.data) && !isGroup(request.resource.data)
          && me() in resource.data.members
          && request.resource.data.members == resource.data.members
          // blockedBy каждый меняет только за себя: добавить или убрать можно лишь свой uid
          && request.resource.data.get('blockedBy', []).toSet()
               .difference(resource.data.get('blockedBy', []).toSet()).hasOnly([me()])
          && resource.data.get('blockedBy', []).toSet()
               .difference(request.resource.data.get('blockedBy', []).toSet()).hasOnly([me()]))
        || (isGroup(resource.data) && groupUpdate())
      );
      // последний участник может удалить группу целиком
      allow delete: if signedIn() && isGroup(resource.data)
        && resource.data.owner == me() && resource.data.members == [me()];

      match /messages/{msgId} {
        function member() {
          return me() in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }
        allow read: if signedIn() && member();
        allow create: if signedIn() && member() && chatOpen(chatId)
          && request.resource.data.from == me()
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && request.resource.data.get('type', 'text') in ['text', 'voice', 'call', 'image', 'file'];
      }

      // Голосовые сообщения: звук хранится прямо в документе (до ~1 МБ)
      match /media/{mediaId} {
        function memberM() {
          return me() in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }
        allow read: if signedIn() && memberM();
        allow create: if signedIn() && memberM() && chatOpen(chatId)
          && request.resource.data.from == me()
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 1000000;
      }
    }

    // Жалобы: отправить может участник чата, читать — только владелец проекта (консоль Firebase)
    match /reports/{reportId} {
      function chatMembers() {
        return get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.members;
      }
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'reported', 'chatId', 'reason', 'comment', 'messages', 'status', 'at'])
        && request.resource.data.from == me()
        && request.resource.data.reported != me()
        && request.resource.data.chatId is string
        && me() in chatMembers()
        && request.resource.data.reported in chatMembers()
        && request.resource.data.reason in ['spam', 'abuse', 'threats', 'adult', 'fraud', 'other']
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && request.resource.data.messages is list
        && request.resource.data.messages.size() <= 5
        && request.resource.data.status == 'new'
        && request.resource.data.at == request.time;
    }

    // Групповые звонки: доступ — участникам группы. Каждый добавляет/убирает из звонка только себя.
    function inGroup(chatId) {
      return me() in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }
    match /groupCalls/{callId} {
      function callChat() { return get(/databases/$(database)/documents/groupCalls/$(callId)).data.chatId; }
      allow read: if signedIn() && inGroup(resource.data.chatId);
      allow create: if signedIn() && request.resource.data.from == me()
        && request.resource.data.chatId is string
        && inGroup(request.resource.data.chatId)
        && request.resource.data.participants == [me()]
        && request.resource.data.ended == false;
      allow update: if signedIn() && inGroup(resource.data.chatId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'ended'])
        && request.resource.data.participants.toSet().difference(resource.data.participants.toSet()).hasOnly([me()])
        && resource.data.participants.toSet().difference(request.resource.data.participants.toSet()).hasOnly([me()])
        && request.resource.data.participants.size() <= 8;

      match /links/{linkId} {
        allow read: if signedIn() && inGroup(callChat());
        allow create, update: if signedIn() && inGroup(callChat())
          && (request.resource.data.from == me() || request.resource.data.to == me())
          && linkId.split('_').hasAll([request.resource.data.from, request.resource.data.to]);

        match /ice/{iceId} {
          allow read: if signedIn() && inGroup(callChat());
          allow create: if signedIn() && inGroup(callChat()) && request.resource.data.from == me();
        }
      }
    }

    // Звонки: служебный документ для установки соединения (WebRTC). Доступ — только двум участникам.
    match /calls/{callId} {
      allow read: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow create: if signedIn() && request.resource.data.from == me()
        && request.resource.data.to is string
        && (!exists(/databases/$(database)/documents/chats/$(chatOf(me(), request.resource.data.to)))
            || chatOpen(chatOf(me(), request.resource.data.to)));
      allow update: if signedIn() && (resource.data.from == me() || resource.data.to == me())
        && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to;

      match /{side}/{candidateId} {
        function party() {
          let c = get(/databases/$(database)/documents/calls/$(callId)).data;
          return me() == c.from || me() == c.to;
        }
        allow read, create: if signedIn() && party();
      }
    }
  }
}
