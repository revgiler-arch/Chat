rules_version = '2';

// Правила доступа к базе: каждый видит только свои чаты и пишет только от своего имени.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    // id чата двух людей — как в приложении: uid по алфавиту через «_»
    function chatOf(a, b) { return a < b ? a + '_' + b : b + '_' + a; }

    // Блокировка: пока в чате кто-то кого-то заблокировал, ни писать, ни звонить нельзя
    function chatOpen(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.get('blockedBy', []).size() == 0;
    }

    // Профили: читать может любой вошедший (чтобы находить друг друга), менять — только свой
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,20}$');
    }

    // Занятые имена @username: одно имя — один владелец
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me()
        && name.matches('^[a-z0-9_]{3,20}$');
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Чаты на двоих: доступ только участникам
    match /chats/{chatId} {
      allow read: if signedIn() && me() in resource.data.members;
      allow create: if signedIn() && me() in request.resource.data.members
        && request.resource.data.members.size() == 2
        // id чата обязан совпадать с парой участников — иначе можно «занять» чужой чат заранее
        && chatId == chatOf(request.resource.data.members[0], request.resource.data.members[1])
        && request.resource.data.get('blockedBy', []).toSet().hasOnly([me()]);
      // blockedBy каждый меняет только за себя: добавить или убрать можно лишь свой uid
      allow update: if signedIn() && me() in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.get('blockedBy', []).toSet()
             .difference(resource.data.get('blockedBy', []).toSet()).hasOnly([me()])
        && resource.data.get('blockedBy', []).toSet()
             .difference(request.resource.data.get('blockedBy', []).toSet()).hasOnly([me()]);

      match /messages/{msgId} {
        function member() {
          return me() in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }
        allow read: if signedIn() && member();
        allow create: if signedIn() && member() && chatOpen(chatId)
          && request.resource.data.from == me()
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && request.resource.data.get('type', 'text') in ['text', 'voice', 'call', 'image', 'file'];
      }

      // Голосовые сообщения: звук хранится прямо в документе (до ~1 МБ)
      match /media/{mediaId} {
        function memberM() {
          return me() in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }
        allow read: if signedIn() && memberM();
        allow create: if signedIn() && memberM() && chatOpen(chatId)
          && request.resource.data.from == me()
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 1000000;
      }
    }

    // Жалобы: отправить может участник чата, читать — только владелец проекта (консоль Firebase)
    match /reports/{reportId} {
      function chatMembers() {
        return get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.members;
      }
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'reported', 'chatId', 'reason', 'comment', 'messages', 'status', 'at'])
        && request.resource.data.from == me()
        && request.resource.data.reported != me()
        && request.resource.data.chatId is string
        && me() in chatMembers()
        && request.resource.data.reported in chatMembers()
        && request.resource.data.reason in ['spam', 'abuse', 'threats', 'adult', 'fraud', 'other']
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && request.resource.data.messages is list
        && request.resource.data.messages.size() <= 5
        && request.resource.data.status == 'new'
        && request.resource.data.at == request.time;
    }

    // Звонки: служебный документ для установки соединения (WebRTC). Доступ — только двум участникам.
    match /calls/{callId} {
      allow read: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow create: if signedIn() && request.resource.data.from == me()
        && request.resource.data.to is string
        && (!exists(/databases/$(database)/documents/chats/$(chatOf(me(), request.resource.data.to)))
            || chatOpen(chatOf(me(), request.resource.data.to)));
      allow update: if signedIn() && (resource.data.from == me() || resource.data.to == me())
        && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to;

      match /{side}/{candidateId} {
        function party() {
          let c = get(/databases/$(database)/documents/calls/$(callId)).data;
          return me() == c.from || me() == c.to;
        }
        allow read, create: if signedIn() && party();
      }
    }
  }
}
